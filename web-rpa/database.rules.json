// Security Rules ของ Realtime Database
//
// เดิม DB เปิดทั้งอ่านและเขียนให้ทุกคน — ใครรู้ URL ก็ยิง REST อ่านหรือลบข้อมูลทิ้งได้
//
// แนวคิดของกฎชุดนี้:
//   • อ่าน  = เปิดให้ทุกคน  -> จอ TV (tv.html) เปิดค้างได้โดยไม่ต้อง login
//   • เขียน = ต้อง login    -> ปุ่มแก้/ลบบน Dashboard ต้องเข้าสู่ระบบก่อน
//   • path อื่นที่ไม่ได้ระบุ = ปิดทั้งอ่านและเขียน
//
// API (main.py) และ Cloud Functions ใช้ Firebase Admin SDK ซึ่ง bypass rules ทั้งหมด
// จึงไม่ได้รับผลกระทบใดๆ — บอททุกตัวยิง log ได้เหมือนเดิม ไม่ต้องแก้อะไร
//
// อยากล็อกการอ่านด้วย ให้เปลี่ยน .read เป็น "auth != null"
// แต่ต้องไป login บนจอ TV ก่อน ไม่งั้น wallboard จะขึ้นว่างเปล่า
//
// ⚠️ ต้องเปิด Google sign-in + เติม apiKey ใน index.html ให้เรียบร้อยก่อน deploy ไฟล์นี้
//    (ดูหัวข้อ "ความปลอดภัย" ใน README) มิฉะนั้นปุ่มแก้/ลบจะใช้ไม่ได้
//
// Deploy:  cd web-rpa && firebase deploy --only database
{
  "rules": {
    ".read": false,
    ".write": false,

    "rpa_live_status": {
      ".read": true,
      ".write": "auth != null",

      "$bot_name": {
        ".validate": "newData.hasChild('status')",
        "status": { ".validate": "newData.isString()" },
        "stage": { ".validate": "newData.isString()" },
        "error_message": { ".validate": "newData.isString()" },
        "status_datetime": { ".validate": "newData.isString()" },
        "timeout_at": { ".validate": "newData.isString()" },
        "$other": { ".validate": false }
      }
    },

    "rpa_history_logs": {
      ".read": true,
      ".write": "auth != null",

      // index ที่ Dashboard ใช้ query (orderByChild('status_datetime'))
      // ถ้าลบบรรทัดนี้ออก query จะกลายเป็นดึงทั้ง node มา sort ฝั่ง client
      ".indexOn": ["status_datetime"],

      "$log_id": {
        ".validate": "newData.hasChildren(['bot_name', 'status'])",
        "bot_name": { ".validate": "newData.isString()" },
        "status": { ".validate": "newData.isString()" },
        "stage": { ".validate": "newData.isString()" },
        "error_message": { ".validate": "newData.isString()" },
        "status_datetime": { ".validate": "newData.isString()" },
        "$other": { ".validate": false }
      }
    },

    // ผังว่าบอทตัวไหนรันอยู่บน server เครื่องไหน (หน้า servers.html)
    // เป็นข้อมูลที่คนกรอกเอง ไม่ใช่ log ที่บอทยิงเข้ามา — ย้ายมาจาก draw.io ที่เดิมต้องส่งไฟล์กันในทีม
    "rpa_server_map": {
      ".read": true,
      ".write": "auth != null",

      "servers": {
        "$server_id": {
          ".validate": "newData.hasChild('name')",
          "name": { ".validate": "newData.isString() && newData.val().length <= 80" },
          "kind": { ".validate": "newData.isString()" },
          "note": { ".validate": "newData.isString() && newData.val().length <= 200" },
          "order": { ".validate": "newData.isNumber()" },
          "$other": { ".validate": false }
        }
      },

      "bots": {
        "$bot_id": {
          // server_id = "__archived" คือบอทที่เลิกรันแล้ว เก็บไว้ดูประวัติ (ไม่ใช่ id ของเครื่องจริง)
          ".validate": "newData.hasChildren(['name', 'server_id'])",
          "name": { ".validate": "newData.isString() && newData.val().length <= 120" },
          "server_id": { ".validate": "newData.isString()" },
          "tag": { ".validate": "newData.isString()" },
          "note": { ".validate": "newData.isString() && newData.val().length <= 200" },
          "order": { ".validate": "newData.isNumber()" },
          // 2 ฟิลด์นี้มีเฉพาะตอนอยู่ในคลัง — ถูกลบออกเมื่อลากกลับไปรันบนเครื่องจริง
          "archived_at": { ".validate": "newData.isString() && newData.val().length <= 25" },
          "archived_from": { ".validate": "newData.isString() && newData.val().length <= 80" },
          // เผื่ออนาคตอยากผูกกับ rpa_live_status: เก็บชื่อ bot_name ที่ใช้ยิง log
          "log_key": { ".validate": "newData.isString() && newData.val().length <= 120" },
          "$other": { ".validate": false }
        }
      }
    }
  }
}
